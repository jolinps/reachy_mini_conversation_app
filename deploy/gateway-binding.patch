+"""Read Hermes profiles from an authoritative source.
+
+The order is the installed API list, then hermes_cli.profiles when that
+package is installed beside the gateway, then the profile name explicitly
+set in the gateway process environment. An empty environment does not
+become the name "default". Directory scans and model replies are not sources.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+
+
+def discover_installed(client, environ=None) -> dict:
+    try:
+        status, payload = client._request("GET", "/api/profiles", None, acceptable=(404, 401, 403, 405))
+    except Exception:
+        return _failed("The Hermes profile list did not answer.", "api")
+    if status == 200 and isinstance(payload, dict) and isinstance(payload.get("profiles"), list):
+        return _ready(payload["profiles"], "api")
+    if status == 404 or status == 405:
+        official = _official_cli()
+        if official is not None:
+            return official
+        configured = configured_execution_context(environ)
+        if configured is not None:
+            return configured
+        return {
+            "status": "unsupported",
+            "error": (
+                "This Hermes API server does not list profiles, and hermes_cli.profiles "
+                "is not installed beside the gateway. HERMES_PROFILE is not set on this "
+                "process, so no profile, including default, was added."
+            ),
+            "profiles": [],
+            "source": "none",
+            "fingerprint": "",
+        }
+    if status in {401, 403}:
+        return _failed("The Hermes profile list rejected the gateway credential.", "api")
+    return _failed("The Hermes profile list was not a profile catalog.", "api")
+
+
+def configured_execution_context(environ=None) -> dict | None:
+    """Report the profile the gateway process was explicitly configured to call.
+
+    The gateway client appends ``/p/<HERMES_PROFILE>`` to HERMES_BASE_URL.
+    Both values have to be present. A missing name is not treated as default,
+    and a capabilities response is not a profile name.
+    """
+    env = os.environ if environ is None else environ
+    base = str(env.get("HERMES_BASE_URL", "")).strip()
+    profile = str(env.get("HERMES_PROFILE", "")).strip().strip("/")
+    if not base or not profile or "/" in profile or profile in {".", ".."}:
+        return None
+    found = _ready(
+        [{"name": profile, "display_name": profile, "enabled": True}],
+        "process_environment",
+    )
+    found["profiles"][0]["configured_route"] = f"/p/{profile}"
+    found["profiles"][0]["routing"] = "profile_prefix"
+    found["evidence"] = (
+        "HERMES_BASE_URL and HERMES_PROFILE are set on the gateway process. "
+        "This client routes that name as /p/<profile>. Additional named profiles "
+        "were not listed. This is not a host inspection and does not verify a reply."
+    )
+    return found
+
+
+def fingerprint(profiles: list[dict]) -> str:
+    body = [
+        {
+            "id": row["backend_profile_id"],
+            "name": row["display_name"],
+            "model": row["model"],
+            "provider": row["provider"],
+            "enabled": row["enabled"],
+        }
+        for row in profiles
+    ]
+    raw = json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _ready(rows: list, source: str) -> dict:
+    profiles = []
+    seen = set()
+    for row in rows:
+        parsed = _one(row)
+        if parsed is None or parsed["backend_profile_id"] in seen:
+            continue
+        seen.add(parsed["backend_profile_id"])
+        profiles.append(parsed)
+    return {
+        "status": "fresh",
+        "error": "",
+        "profiles": profiles,
+        "source": source,
+        "fingerprint": fingerprint(profiles),
+    }
+
+
+def _one(row) -> dict | None:
+    if isinstance(row, dict):
+        data = row
+    else:
+        data = {
+            "name": getattr(row, "name", None),
+            "display_name": getattr(row, "display_name", None),
+            "model": getattr(row, "model", None),
+            "provider": getattr(row, "provider", None),
+            "enabled": getattr(row, "enabled", True),
+            "capabilities": getattr(row, "capabilities", None),
+            "description": getattr(row, "description", None),
+        }
+    identifier = data.get("name") or data.get("profile") or data.get("id") or ""
+    if not isinstance(identifier, str) or not identifier.strip() or "/" in identifier:
+        return None
+    capabilities = data.get("capabilities") if isinstance(data.get("capabilities"), list) else []
+    return {
+        "backend_profile_id": identifier.strip(),
+        "display_name": _text(data.get("display_name") or data.get("description") or identifier),
+        "model": _text(data.get("model") or data.get("model_name") or ""),
+        "provider": _text(data.get("provider") or ""),
+        "capabilities": [item for item in capabilities if isinstance(item, str)][:20],
+        "enabled": data.get("enabled") is not False,
+    }
+
+
+def _text(value) -> str:
+    if not isinstance(value, str):
+        return ""
+    return value.strip()[:120]
+
+
+def _failed(error: str, source: str) -> dict:
+    return {"status": "failed", "error": error, "profiles": [], "source": source, "fingerprint": ""}
+
+
+def _official_cli() -> dict | None:
+    try:
+        from hermes_cli.profiles import list_profiles
+    except ImportError:
+        return None
+    try:
+        rows = list_profiles()
+    except Exception:
+        return _failed("hermes_cli.profiles.list_profiles did not answer.", "hermes_cli")
+    if not isinstance(rows, list):
+        return _failed("hermes_cli.profiles.list_profiles did not return a list.", "hermes_cli")
+    return _ready(rows, "hermes_cli")
