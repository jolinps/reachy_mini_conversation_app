+def _stamp(item: dict, chat_request: dict) -> dict:
+    """Attach the destination frozen at bind time. Later selection changes do not rewrite it."""
+    stamped = dict(item)
+    for key in ("agent_id", "assignment_epoch", "gateway_request_id", "backend_instance"):
+        if key in chat_request:
+            stamped[key] = chat_request[key]
+    return stamped
+
+
+def _binding_event(chat_request: dict) -> dict | None:
+    if "gateway_request_id" not in chat_request:
+        return None
+    return event(
+        "binding",
+        request_id=chat_request["request_id"],
+        agent_id=chat_request["agent_id"],
+        assignment_epoch=chat_request["assignment_epoch"],
+        gateway_request_id=chat_request["gateway_request_id"],
+        backend_instance=chat_request["backend_instance"],
+    )
+
+
+def _cancelled_event(chat_request: dict, request_id: str) -> dict:
+    return _stamp(
+        {"type": "cancelled", "request_id": request_id or chat_request.get("request_id", "")},
+        chat_request,
+    )
+
