+def _safe_catalog(method) -> dict:
+    empty = {"status": "unsupported", "error": "This destination does not list Hermes profiles.", "profiles": [], "source": "none", "fingerprint": "", "evidence": ""}
+    if method is None:
+        return empty
+    try:
+        payload = method()
+    except Exception:
+        return {"status": "failed", "error": "Profile discovery failed.", "profiles": [], "source": "backend", "fingerprint": "", "evidence": ""}
+    if not isinstance(payload, dict):
+        return {"status": "failed", "error": "Profile discovery failed.", "profiles": [], "source": "backend", "fingerprint": "", "evidence": ""}
+    status = payload.get("status") if payload.get("status") in {"fresh", "failed", "unsupported"} else "failed"
+    profiles = []
+    if status == "fresh":
+        for row in payload.get("profiles") or []:
+            if not isinstance(row, dict):
+                continue
+            name = row.get("backend_profile_id")
+            if not isinstance(name, str) or not name.strip():
+                continue
+            route = str(row.get("configured_route") or "")
+            identifier = name.strip()
+            if route and route != f"/p/{identifier}":
+                route = ""
+            profiles.append(
+                {
+                    "backend_profile_id": identifier,
+                    "display_name": str(row.get("display_name") or name).strip()[:120],
+                    "model": str(row.get("model") or "")[:120],
+                    "provider": str(row.get("provider") or "")[:120],
+                    "capabilities": [item for item in row.get("capabilities") or [] if isinstance(item, str)][:20],
+                    "enabled": row.get("enabled") is not False,
+                    "configured_route": route,
+                    "routing": "profile_prefix" if route else "",
+                }
+            )
+    return {
+        "status": status,
+        "error": str(payload.get("error") or "")[:300],
+        "profiles": profiles,
+        "source": str(payload.get("source") or "")[:40],
+        "fingerprint": str(payload.get("fingerprint") or "")[:80],
+        "evidence": str(payload.get("evidence") or "")[:300],
+    }
+
