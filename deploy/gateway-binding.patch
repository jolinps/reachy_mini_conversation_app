+    def _backup_schema_transition(self) -> None:
+        """Copy a populated database once before this process raises its schema."""
+        if not self.path.is_file() or self.path.stat().st_size == 0:
+            return
+        backup = Path(str(self.path) + f".bak-before-{SCHEMA_VERSION}")
+        if backup.exists():
+            return
+        try:
+            with sqlite3.connect(self.path) as conn:
+                present = conn.execute(
+                    "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'schema_version'"
+                ).fetchone()
+                if present is None:
+                    stored = 0
+                else:
+                    row = conn.execute("SELECT version FROM schema_version").fetchone()
+                    stored = int(row[0]) if row is not None else 0
+                devices = conn.execute(
+                    "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'devices'"
+                ).fetchone()
+                if devices is None:
+                    return
+                occupied = conn.execute("SELECT 1 FROM devices LIMIT 1").fetchone()
+        except sqlite3.Error:
+            return
+        if occupied is None or stored >= SCHEMA_VERSION:
+            return
+        shutil.copy2(self.path, backup)
+        try:
+            os.chmod(backup, 0o600)
+        except OSError:
+            pass
