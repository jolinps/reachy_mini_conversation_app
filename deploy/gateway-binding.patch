+class CountingHermes(FakeHermes):
+    def __init__(self):
+        self.calls = []
+
+    def chat(self, session_id, text, on_progress, should_cancel):
+        self.calls.append((session_id, text))
+        return super().chat(session_id, text, on_progress, should_cancel)
