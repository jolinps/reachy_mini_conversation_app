+    def _chat(self, headers, agent_id, epoch, scope_id, text, request_id) -> str:
+        body = {
+            "request_id": request_id,
+            "conversation_id": "reachy-not-used",
+            "text": text,
+            "expected_agent_id": agent_id,
+            "expected_epoch": epoch,
+            "text_only": True,
+        }
+        if scope_id:
+            body["scope_id"] = scope_id
+        response = self.client.post("/v1/chat", headers=headers, json=body)
+        self.assertEqual(response.status_code, 200, response.text)
+        return response.text
+
+    @staticmethod
+    def _events(body: str) -> list[dict]:
+        return [json.loads(line) for line in body.splitlines() if line.strip()]
+
+    @staticmethod
+    def _answer(body: str) -> str:
+        parser = TurnParser()
+        parser.feed(body if body.endswith("\n") else body + "\n")
+        parser.finish()
+        return parser.final_text or ""
+
